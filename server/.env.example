PORT=5000
MONGODB_URI=mongodb://localhost:27017/quicktransolution

# Set to "production" on your live server — enables the secure cookie
# flag and trusts the reverse proxy's forwarded IP for rate limiting.
NODE_ENV=development

# Long, random string used to sign admin session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# 32-byte (64 hex character) key used to encrypt service-enquiry PII
# (name/phone/email/address/message) before it's stored in MongoDB.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/rotating this key makes existing encrypted enquiries permanently
# undecryptable — back it up somewhere safe (a password manager / secrets
# vault), separate from this repo.
ENCRYPTION_KEY=replace-with-a-64-character-hex-string

# Must exactly match the URL the frontend is served from — required for
# the httpOnly session cookie to be accepted cross-origin.
CLIENT_ORIGIN=http://localhost:5173

# From the reCAPTCHA v3 admin console (google.com/recaptcha/admin).
# Leave unset in local dev — lookups will work without it, just unverified.
RECAPTCHA_SECRET_KEY=

# Optional. Leave unset for local dev — rate limiting and auth caching
# fall back to in-memory automatically. Set this in production once you
# have real traffic (e.g. a managed Redis from Upstash/Railway/Render):
#   redis://default:<password>@<host>:<port>
REDIS_URL=redis://default:AbCdEf123456@fluent-mole-12345.upstash.io:6379


# SMTP credentials used to send signup email-verification codes
# (server/src/utils/mailer.js). Works with any SMTP provider — for
# production, a transactional-email service gives much better inbox
# deliverability than sending from a generic mail server. Brevo's free
# tier (300 emails/day, no cost) is a solid production-ready default for
# a site at this scale:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<your Brevo SMTP login>
#   SMTP_PASS=<your Brevo SMTP key>
#   SMTP_FROM=no-reply@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Your existing SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS can stay exactly as they are — they're simply unused while MAIL_METHOD=api, kept ready in case you ever upgrade Render or move hosts and want to flip back to MAIL_METHOD=smtp with zero code changes.
MAIL_METHOD=api
BREVO_API_KEY=<the key you just generated>